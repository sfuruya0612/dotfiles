# ANSIBLE MANAGED BLOCK: git-delta"
# ユーザー固有情報 ([user] の name / email) は ~/.gitconfig.local に記載する
[include]
    path = ~/.gitconfig.local

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
